# Copy this file to ".env" (same folder) and fill in your own values.
# Never upload ".env" to GitHub (it is already in .gitignore).

# MongoDB Atlas connection string. Leave it empty to run without a database
# (data then lives in memory and disappears when the server restarts).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/tradesdash?retryWrites=true&w=majority

PORT=5000
